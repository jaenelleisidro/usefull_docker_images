OLLAMA_EMBEDDINGS_BASEURL=http://localhost:11434
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text

OLLAMA_QDRANT_URL=http://localhost:6333
OLLAMA_QDRANT_COLLECTION_NAME=training_data
OLLAMA_QDRANT_TRAINING_DATA=./data/training_data/

OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASEURL=http://localhost:11434



OLLAMA_VERSION=latest
OLLAMA_PORT_11434=11434

QDRANT_VERSION=latest
QDRANT_PORT_6333=6333


# Local by default. Change to 0.0.0.0 when you intentionally expose it.
# OLLAMA_BIND_IP=127.0.0.1
# Keep-alive tweaks cold-start latency vs memory footprint.
OLLAMA_KEEP_ALIVE=5m
# Concurrency knobs.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# Leave empty unless you are serving browser clients that hit Ollama directly.
OLLAMA_ORIGINS=